# Required for simulate + live (free Dev tier: https://business.1inch.com/)
ONEINCH_API_KEY=

# Optional — some DexScreener endpoints may require a key
DEXSCREENER_API_KEY=

# Optional for simulate: address used as "from" when building 1inch txs / eth_call.
# Defaults to a known Base USDC holder if unset. Never used to broadcast unless live.
SIMULATE_FROM_ADDRESS=

# Required for live execution only (execution_mode: live)
# NEVER commit a real private key. Use a dedicated trading wallet with limited funds.
WALLET_PRIVATE_KEY=

# RPC endpoints (required for simulate eth_call and live broadcast)
# Prefer dedicated endpoints (Alchemy/Infura/QuickNode) if public ones 429.
BASE_RPC_URL=https://base.publicnode.com
ARBITRUM_RPC_URL=https://arbitrum.publicnode.com

# Backend / dashboard port (default 8001)
API_PORT=8001

# Optional — The Odds API (manual dashboard fetch only; free tier ~500/mo)
# Action Network + ESPN auto-scan without this key.
ODDS_API_KEY=
